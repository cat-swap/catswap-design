{
  "$schema": "https://catswap.design/schema/tokens-v1.json",
  "meta": {
    "name": "catswap-design-tokens",
    "version": "1.0.0",
    "canonical": true,
    "authority": "boss 拍板（10/27-31），DESIGN_SYSTEM.md/index.css 收编",
    "consumers": ["catswap-solana-web", "catswap-docs", "(future) mobile"]
  },
  "color": {
    "brand": {
      "buy":               { "value": "#02C976", "note": "boss 10/27 拍板；旧 #25A750/#F6465D 退役" },
      "buy-hover":         { "value": "#02A566" },
      "buy-light":         { "value": "rgba(2, 201, 118, 0.1)" },
      "buy-bg":            { "value": "rgba(2, 201, 118, 0.08)" },
      "sell":              { "value": "#EB4B6D", "note": "boss 10/27 拍板；旧 #CA3F64/#F6465D 退役" },
      "sell-hover":        { "value": "#D13A5F" },
      "sell-light":        { "value": "rgba(235, 75, 109, 0.1)" },
      "sell-bg":           { "value": "rgba(235, 75, 109, 0.08)" },
      "warning":           { "value": "#F0B90B" },
      "info":              { "value": "#3398DB" },
      "success":           { "value": "{color.brand.buy}",      "alias": true },
      "success-hover":     { "value": "{color.brand.buy-hover}", "alias": true },
      "danger":            { "value": "{color.brand.sell}",     "alias": true },
      "danger-hover":      { "value": "{color.brand.sell-hover}","alias": true }
    },
    "bg": {
      "primary":   { "value": "#2E2E2E" },
      "secondary": { "value": "#000000" },
      "tertiary":  { "value": "#1A1A1A" },
      "quaternary":{ "value": "#2E2E2E" },
      "hover":     { "value": "#2E2E2E" },
      "active":    { "value": "#3C3C3C" },
      "input":     { "value": "#1A1A1A" },
      "card":      { "value": "#000000" },
      "tooltip":   { "value": "#2E2E2E" }
    },
    "border": {
      "primary":   { "value": "#2E2E2E" },
      "secondary": { "value": "#2E2E2E" },
      "hover":     { "value": "#3C3C3C" },
      "active":    { "value": "#4A4A4A" }
    },
    "text": {
      "primary":   { "value": "#EAECEF" },
      "secondary": { "value": "#848E9C" },
      "tertiary":  { "value": "#5E6673" },
      "muted":     { "value": "#474D57" }
    },
    "exceptions": {
      "solana-gradient": { "value": "#14F195 -> #9945FF", "note": "例外保留：Solana 品牌渐变" },
      "coin-usdt":       { "value": "#26A17B" },
      "coin-avax":       { "value": "#E84142", "note": "币种色例外保留" }
    }
  },
  "typography": {
    "scale": {
      "xs":  { "value": "12px" },
      "sm":  { "value": "13px" },
      "base":{ "value": "14px" },
      "lg":  { "value": "16px" },
      "xl":  { "value": "20px" }
    },
    "weight": { "normal": "400", "medium": "500", "semibold": "600" },
    "numeric": { "font-variant-numeric": "tabular-nums", "note": "所有数字列" }
  },
  "spacing": {
    "control-height": { "sm": "28px", "md": "36px", "lg": "40px" },
    "radius":         { "sm": "4px", "md": "6px", "lg": "8px", "xl": "12px", "full": "9999px", "note": "D0009: 数据面板封顶 6px" },
    "padding":        { "control-x": "12px" }
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px rgba(0, 0, 0, 0.08)",
    "lg": "0 10px 20px rgba(0, 0, 0, 0.1)",
    "xl": "0 20px 40px rgba(0, 0, 0, 0.12)"
  },
  "motion": {
    "transition": { "fast": "150ms ease", "base": "200ms ease", "slow": "300ms ease" },
    "rule": "transition-colors 优先；禁止 transition-all"
  },
  "alias": {
    "success": { "value": "{color.brand.buy}", "alias": true, "note": "裸名别名：ReferralPage 等历史用法" },
    "danger":  { "value": "{color.brand.sell}", "alias": true, "note": "裸名别名：历史用法" }
  }
}
